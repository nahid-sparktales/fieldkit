{
  "name": "fieldkit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx apps/api/main.ts",
    "worker": "tsx apps/worker/main.ts",
    "start": "NODE_ENV=production tsx apps/api/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:runner": "tsx scripts/verify-runner.ts",
    "test:browser": "playwright test",
    "test:live": "tsx scripts/verify-live.ts",
    "test:demo": "npm --prefix examples/demo test",
    "demo": "npm --prefix examples/demo run dev",
    "fieldkit": "tsx apps/cli/main.ts",
    "mcp": "tsx packages/mcp/src/server.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "rotate-key": "tsx scripts/rotate-encryption-key.ts",
    "sandbox": "npm run build && tsx scripts/store-sandbox/main.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "better-auth": "1.7.6",
    "cheerio": "1.2.0",
    "mammoth": "1.13.0",
    "nodemailer": "10.0.13",
    "openai": "7.25.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "tsx": "4.23.15",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "license": "Apache-2.0",
  "description": "Self-hosted AI support, knowledge, customer portal, and governed business actions"
}
