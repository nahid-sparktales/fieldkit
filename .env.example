# Run npm run setup to generate unique secrets in an ignored .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://fieldkit:replace-with-a-long-random-password@localhost:5432/fieldkit
FIELDKIT_URL=http://localhost:4317
FIELDKIT_PORT=4317
FIELDKIT_HOST=127.0.0.1
FIELDKIT_DATA=.fieldkit/v2
FIELDKIT_ENCRYPTION_KEY=generate-32-random-bytes-in-base64
BETTER_AUTH_SECRET=generate-at-least-32-random-characters
FIELDKIT_SETUP_TOKEN=generate-at-least-24-random-characters
SMTP_URL=smtps://username:password@smtp.example.com:465
SMTP_FROM=FieldKit <support@example.com>
# Optional: exact, comma-separated private model API bases reachable by app AND worker.
# FIELDKIT_MODEL_ENDPOINTS=http://vllm:8000/v1,http://embeddings:8000/v1
# Operator-owned provider application registrations:
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_KEY=
GOOGLE_APP_ID=
# Tests only; must name a dedicated database ending in _test.
# TEST_DATABASE_URL=postgresql://fieldkit:password@localhost:5432/fieldkit_test
